# ---- Required ---------------------------------------------------------------
# Generate each with: openssl rand -hex 32
SECRET_KEY=
# signs the audit chain + exports. Keep it; losing it makes old events unverifiable.
AUDIT_SIGNING_KEY=
BASE_URL=http://localhost:8000
# comma-separated; always admin, cannot be revoked in the UI
BOOTSTRAP_ADMINS=you@example.com

# Try it without any setup: sample data + password-less login. Never on a shared host.
DEMO_MODE=false
# Access requests and offboarding. false = report-only (API 404s, UI hidden).
WORKFLOWS=false
# Security actions (revoke grants, sign out, app passwords, licences). Needs Google sign-in with the auth_time claim
# enabled, and at least two officers who also have the admin role. Every action is approved by a second officer.
ACTIONS=false
SECURITY_OFFICERS=

# ---- Sign-in: Google Workspace (OIDC) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=example.com

# ---- Sign-in: Microsoft Entra ID (OIDC, single tenant) ---------------------
# tenant GUID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- Discovery: Google Workspace (service account + domain-wide delegation) -
GOOGLE_SA_FILE=/secrets/google-sa.json
# admin the service account impersonates
GOOGLE_ADMIN_EMAIL=
# for licence assignments
GOOGLE_CUSTOMER_DOMAIN=example.com

# ---- Discovery: Microsoft Entra ID (app-only Graph read permissions) -------
# Recommended: a separate app registration from sign-in. Falls back to ENTRA_CLIENT_ID/SECRET.
ENTRA_SYNC_CLIENT_ID=
ENTRA_SYNC_CLIENT_SECRET=
# Personio (HR source of truth, read-only): Settings > Integrations > API credentials
PERSONIO_CLIENT_ID=
PERSONIO_CLIENT_SECRET=

# ---- Offboarding (write access, optional; leave empty to keep the app read-only) --
# A SECOND Google service account, used only for offboarding (scopes: see README)
GOOGLE_WRITE_SA_FILE=
# super admin it acts as (defaults to GOOGLE_ADMIN_EMAIL)
GOOGLE_WRITE_ADMIN_EMAIL=
# A THIRD Entra app registration: User.EnableDisableAccount.All, User.RevokeSessions.All
ENTRA_WRITE_CLIENT_ID=
ENTRA_WRITE_CLIENT_SECRET=

# ---- Tuning -----------------------------------------------------------------
SYNC_INTERVAL_HOURS=6
# seat counts as unused after this many days without activity
INACTIVITY_DAYS=90
# first-sync window for audit/sign-in logs
LOOKBACK_DAYS=30
# name fragments that mark discovered apps as in-house, besides your own domain names (e.g. petolo,faircare)
INTERNAL_APP_HINTS=
SESSION_HOURS=12
